{
  "manifest_version": 2,
  "name": "HbbTV Emulator",
  "version": "1.0.0",
  "description": "HbbTV emulator extension for Firefox",
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "http://*/*",
    "https://*/*"
  ],
  "browser_action": {
    "default_title": "Open HbbTV Emulator"
  },
  "sidebar_action": {
    "default_title": "HbbTV Emulator",
    "default_panel": "index.html",
    "open_at_install": false
  },
  "background": {
    "page": "background.html"
  },
  "web_accessible_resources": ["broadcast/*"],
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "browser_specific_settings": {
    "gecko": {
      "id": "hbbtv-emulator@example.com",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["bridge.js", "injector.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
