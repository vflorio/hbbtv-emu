{
  "name": "@hbb-emu/extension-chrome-v3",
  "version": "1.0.0",
  "dependencies": {
    "@hbb-emu/core": "workspace:*",
    "@hbb-emu/extension-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "0.1.29",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "fp-ts": "2.16.11",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  },
  "main": "./dist/index.js",
  "scripts": {
    "extension:dev": "vite",
    "extension:build": "pnpm extension:build:background && pnpm extension:build:assets",
    "extension:build:assets": "cp -r public/* dist/",
    "extension:build:background": "vite build --config vite.background.config.ts",
    "clean": "rm -rf dist",
    "preview": "vite preview"
  },
  "type": "module"
}
