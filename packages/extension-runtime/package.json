{
  "name": "@hbb-emu/extension-runtime",
  "version": "1.0.0",
  "dependencies": {
    "@hbb-emu/core": "workspace:*",
    "@hbb-emu/oipf-api": "workspace:*",
    "@hbb-emu/protocol": "workspace:*",
    "@hbb-emu/state": "workspace:*",
    "io-ts": "2.2.21"
  },
  "devDependencies": {
    "@types/chrome": "0.1.32",
    "fp-ts": "2.16.11",
    "ts-pattern": "5.9.0",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
